# =====================================================================
# Variables de entorno del backend - Sistema Óptica
# Copia este archivo a .env y completa los valores reales.
# NUNCA versiones el archivo .env con credenciales.
# =====================================================================

# Entorno: development | production
NODE_ENV=development

# Puerto del servidor Express (Railway inyecta PORT automáticamente)
PORT=3000

# Conexión a PostgreSQL (Railway provee esta variable automáticamente)
# Formato: postgresql://usuario:password@host:puerto/basededatos
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/optica

# Activar SSL en la conexión a la DB (true en Railway/producción, false en local)
DB_SSL=false

# Secreto para firmar los tokens JWT (usa una cadena larga y aleatoria)
JWT_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria

# Tiempo de expiración del token (ej: 1h, 8h, 7d)
JWT_EXPIRES_IN=8h

# Origen permitido para CORS (el frontend).
# En despliegue monolito (SERVE_FRONTEND=true) puede quedar como el propio dominio.
# En despliegue separado, apunta al dominio del frontend. Usa * solo en desarrollo.
CORS_ORIGIN=http://localhost:5173

# Sirve el build del frontend (frontend/dist) desde Express.
# true = despliegue monolito (un solo servicio en Railway).
SERVE_FRONTEND=false

# Carpeta de subidas. En Railway, apunta al mount del Volume para persistir
# las imágenes entre despliegues. Ej: /data/uploads
# Si se deja vacío, usa backend/uploads (efímero en Railway).
UPLOAD_DIR=
